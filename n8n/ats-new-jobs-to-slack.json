{
  "name": "New jobs from Greenhouse, Lever & Ashby to Slack (Wisekit ATS Job Feed)",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [ { "field": "days", "triggerAtHour": 7 } ] }
      },
      "id": "6b1f2c1e-0a01-4c3e-9a10-000000000001",
      "name": "Every morning at 07:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/wisekit~ats-job-feed/run-sync-get-dataset-items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"companies\": [\"greenhouse:yourcompany\", \"lever:anothercompany\", \"ashby:thirdcompany\"],\n  \"keywords\": [\"engineer\"],\n  \"monitorName\": \"n8n-morning-jobs\",\n  \"onlyChanges\": true,\n  \"includeDescription\": false\n}",
        "options": { "timeout": 300000 }
      },
      "id": "6b1f2c1e-0a01-4c3e-9a10-000000000002",
      "name": "Run ATS Job Feed (Apify)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0],
      "notes": "Credential: Header Auth with name 'Authorization' and value 'Bearer <your Apify API token>'. Replace the companies with real job boards (greenhouse:board, lever:board, ashby:board or full board URLs). To test for free first, use {\"companies\": [\"demo\"], \"demoMode\": true}."
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.type }}",
              "rightValue": "job",
              "operator": { "type": "string", "operation": "equals" }
            },
            {
              "id": "c2",
              "leftValue": "={{ $json.changeType }}",
              "rightValue": "new",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "6b1f2c1e-0a01-4c3e-9a10-000000000003",
      "name": "Only new jobs",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://hooks.slack.com/services/REPLACE/WITH/YOUR_WEBHOOK",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: `New job at ${$json.companyName || $json.company}: <${$json.jobUrl}|${$json.title}> (${$json.location || 'location not given'})` }) }}",
        "options": {}
      },
      "id": "6b1f2c1e-0a01-4c3e-9a10-000000000004",
      "name": "Post to Slack (incoming webhook)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 0],
      "notes": "Create a Slack incoming webhook for your channel and paste its URL here. Or swap this node for Google Sheets, email or a database."
    }
  ],
  "connections": {
    "Every morning at 07:00": { "main": [ [ { "node": "Run ATS Job Feed (Apify)", "type": "main", "index": 0 } ] ] },
    "Run ATS Job Feed (Apify)": { "main": [ [ { "node": "Only new jobs", "type": "main", "index": 0 } ] ] },
    "Only new jobs": { "main": [ [ { "node": "Post to Slack (incoming webhook)", "type": "main", "index": 0 } ] ] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
